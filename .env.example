# Copy this file to .env and replace every value before running the application.
# Never commit .env or share its values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DB_SERVER=your-sql-server-hostname-or-ip
DB_PORT=1433
DB_DATABASE=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-the-database-password
